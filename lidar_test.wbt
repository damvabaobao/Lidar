# ROBOT

Robot {
  translation 0 0 0.15
  name "LidarRobot"
  controller "lidar_test"

  children [

    # Robot body
    Shape {
      appearance PBRAppearance {
        baseColor 0.15 0.15 0.15
        roughness 0.5
        metalness 0.2
      }
      geometry Cylinder {
        radius 0.35
        height 0.25
      }
    }
    # LIDAR


    Lidar {
      name "lidar"
      translation 0 0 0.25

      horizontalResolution 500
      numberOfLayers 1

      fieldOfView 6.283185
      verticalFieldOfView 0.01

      minRange 0.05
      maxRange 12.0

      resolution 0.001

      type "rotating"
      projection "cylindrical"

      defaultFrequency 10
      minFrequency 1
      maxFrequency 25

      noise 0.0

      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.05 0.05 0.05
            roughness 0.4
            metalness 0.5
          }
          geometry Cylinder {
            radius 0.08
            height 0.05
          }
        }
      ]
    }

  ]

  boundingObject Cylinder {
    radius 0.35
    height 0.25
  }
}

# LIGHT


PointLight {
  location 0 0 6
  intensity 2
  color 1 1 1
}