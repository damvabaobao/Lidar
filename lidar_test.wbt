}

TexturedBackgroundLight {
}

Floor {
  size 12 10
}
# ROOM WALLS

Solid {
  translation 0 5 1
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.7 0.7
        roughness 0.8
      }
      geometry Box {
        size 12 0.2 2
      }
    }
  ]
  boundingObject Box {
    size 12 0.2 2
  }
}

